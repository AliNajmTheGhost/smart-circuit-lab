{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Smart Circuit Lab",
  "version": "0.3.0",
  "identifier": "app.nabd.lab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5190",
    "beforeDevCommand": "npm run dev -- --port 5190 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "مختبر الدوائر الذكية · Smart Circuit Lab",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Ali Najm",
    "shortDescription": "مختبر الدوائر الذكية: محاكاة الدوائر الكهربائية والإلكترونية",
    "longDescription": "مختبر الدوائر الذكية (Smart Circuit Lab): برنامج عربي لمحاكاة الدوائر الكهربائية والإلكترونية لطلاب التعليم المهني، يعمل بدون إنترنت. إعداد المهندس علي نجم.",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sclab",
          "nabd"
        ],
        "name": "Smart Circuit Lab circuit",
        "description": "دائرة مختبر الدوائر الذكية",
        "role": "Editor",
        "mimeType": "application/x-smart-circuit-lab"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "copyright": "© 2026 المهندس علي نجم (Eng. Ali Najm). Free for non-commercial use (PolyForm Noncommercial 1.0.0)."
  },
  "mainBinaryName": "SmartCircuitLab"
}

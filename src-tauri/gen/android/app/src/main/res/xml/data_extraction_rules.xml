<?xml version="1.0" encoding="utf-8"?>
<!--
  Circuits and progress stay on the phone they were made on. Nothing is copied to a cloud
  backup or handed to another device, so a backup file can never carry the lab's data away.
  Android 12 and later read these rules; older phones follow android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

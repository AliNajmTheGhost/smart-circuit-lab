{
  "name": "nabd",
  "version": "0.3.0",
  "description": "مختبر الدوائر الذكية (Smart Circuit Lab) - محاكاة الدوائر الكهربائية والإلكترونية لطلاب التعليم المهني",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run build:wasm && vitest run && node scripts/cargo.mjs test --workspace",
    "test:web": "vitest run",
    "test:ts-engine": "cross-env NABD_ENGINE=ts vitest run",
    "test:rust": "node scripts/cargo.mjs test --workspace",
    "bench": "cross-env NABD_BENCH=1 vitest run --reporter=verbose",
    "golden": "tsx scripts/make-golden.ts",
    "catalog": "tsx scripts/export-catalog.ts",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build:wasm && tsc --noEmit && vite build --mode single && node -e \"require('fs').renameSync('dist-single/index.html','dist-single/nabd.html')\"",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:android": "node scripts/build-android.mjs",
    "build:desktop:offline": "node scripts/build-desktop.mjs --offline"
  },
  "author": "Ali Najm (المهندس علي نجم)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@tauri-apps/api": "^2.12.1"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AliNajmTheGhost/smart-circuit-lab"
  }
}
